import glob
import os
import yaml

# Load the configuration file, unless config was already populated by a parent
# workflow importing this Snakefile via Snakemake's `module:` mechanism with
# `config: config` (see snakemake.readthedocs.io/en/stable/snakefiles/deployment.html).
if not config:
    configfile: "config.yaml"

# Directory containing input FASTQ files. Defaults to "0_data" for standalone
# use; override via config["sedimix_data_dir"] when importing as a module.
data_dir = config.get("sedimix_data_dir", "0_data")

# Extract and preprocess `types` from the configuration
types = config["types"].split(",")  # This creates a list of types
types_str = " ".join(types)  # This creates a space-separated string

# List all .fq and .fq.gz files in the data folder
fq_files = glob.glob(f"{data_dir}/*.fq")
gz_files = glob.glob(f"{data_dir}/*.fq.gz")

# If there are .fq.gz files, include them in the list of input files
input_files = fq_files + [f.replace(".fq.gz", ".fq") for f in gz_files]

# Define the final output files
rule all:
    input:
        expand([
            "results/mapdamage/{sample}",
            "results/final_reads/{sample}_final.bam", 
            "results/final_reads/{sample}_final_deaminated.bam", 
            "results/final_reads/{sample}_final_non_deaminated.bam", 
            "results/final_report/{sample}.tsv"
        ], sample=[os.path.basename(f).split('.fq')[0] for f in input_files]),
        expand("results/final_reads/{sample}_non_hominin.fq", 
        sample=[os.path.basename(f).split('.fq')[0] for f in input_files]) if config.get("keep_non_hominin_reads", False) else [],
        "results/final_report/combined_final_report.tsv"

# Unzip fastq.gz files if necessary
if gz_files:
    rule unzip_fq_files:
        input:
            f"{data_dir}/{{sample}}.fq.gz"
        output:
            f"{data_dir}/{{sample}}.fq"
        benchmark:
            "results/benchmarks/unzip_fq_files/{sample}.txt"
        shell:
            "gunzip -c {input} > {output}"

# Filter reads based on length before classification
rule filter_reads_by_length:
    input:
        f"{data_dir}/{{sample}}.fq"
    output:
        temp("results/temp/{sample}_length_filtered.fq")
    params:
        min_length=config["min_length"]
    benchmark:
        "results/benchmarks/filter_reads_by_length/{sample}.txt"
    shell:
        """
        awk '(NR%4==1){{h=$0}} (NR%4==2){{s=$0}} (NR%4==3){{p=$0}} (NR%4==0 && length(s)>={params.min_length}){{print h; print s; print p; print $0}}' {input} > {output}
        """

# Classification using Kraken2 or Centrifuge 
if (config['classification_software'] == "kraken2"): 
    rule classification:
        input:
            "results/temp/{sample}_length_filtered.fq"
        output:
            kraken2_results="results/classification/{sample}.kraken2",
            kraken2_report="results/classification/{sample}.k2report"
        params:
            kraken2_db=config["classification_index"]
        resources:
            mem_mb=config['memory_mb']  # in MB
        threads: config["threads"]
        benchmark:
            "results/benchmarks/classification/{sample}.txt"
        shell:
            """
            kraken2 --db {params.kraken2_db} --output {output.kraken2_results} --report {output.kraken2_report} {input} --threads {threads}
            """

    # Generate classified reads after Kraken2
    rule generate_classified_reads:
        input:
            kraken2_result="results/classification/{sample}.kraken2",
            fq="results/temp/{sample}_length_filtered.fq",
            script=workflow.source_path("../scripts/select_reads_from_kraken2.py")
        output:
            fq_classified=temp("results/temp/{sample}_length_filtered_classified.fq"),
            reads_list=temp("results/temp/{sample}_reads.lst")
        params:
            taxID=config['taxID']
        benchmark:
            "results/benchmarks/generate_classified_reads/{sample}.txt"
        shell:
            """
            python {input.script} {params.taxID} {input.kraken2_result} {wildcards.sample}
            mv {wildcards.sample}_reads.lst {output.reads_list}
            seqtk subseq {input.fq} {output.reads_list} > {output.fq_classified}
            """
            
elif (config['classification_software'] == "centrifuge"): 
    rule classification:
        input:
            "results/temp/{sample}_length_filtered.fq"
        output:
            centrifuge_results="results/classification/{sample}.centrifuge",
            centrifuge_report="results/classification/{sample}.centrifugeLog",
            kreport="results/classification/{sample}.k2report"
        params:
            centrifuge_db=config["classification_index"]
        threads: config['threads']
        resources:
            mem_mb=config['memory_mb']  # in MB
        benchmark:
            "results/benchmarks/classification/{sample}.txt"
        shell:
            """
            centrifuge -x {params.centrifuge_db} -S {output.centrifuge_results} --report-file {output.centrifuge_report} -U {input} -p {threads}
            centrifuge-kreport -x {params.centrifuge_db} {output.centrifuge_results} > {output.kreport}
            """

    # Generate classified reads after Centrifuge
    rule generate_classified_reads:
        input:
            centrifuge_results="results/classification/{sample}.centrifuge",
            fq="results/temp/{sample}_length_filtered.fq",
            script=workflow.source_path("../scripts/select_reads_from_centrifuge.py")
        output:
            fq_classified=temp("results/temp/{sample}_length_filtered_classified.fq")
        params:
            taxID=config['taxID']
        benchmark:
            "results/benchmarks/generate_classified_reads/{sample}.txt"
        shell:
            """
            python {input.script} {params.taxID} {input.centrifuge_results} {wildcards.sample}
            mv {wildcards.sample}_reads.lst results/classification/
            seqtk subseq {input.fq} results/classification/{wildcards.sample}_reads.lst > {output.fq_classified}
            """

# Map reads using bwa to the reference genome, convert to BAM, sort, and index (use classified reads)
rule map_sort_index:
    input:
        "results/temp/{sample}_length_filtered_classified.fq"
    output:
        bam="results/mapping/{sample}_length_filtered_classified.bam",
        bam_bai="results/mapping/{sample}_length_filtered_classified.bam.bai",
        sai=temp("results/temp/{sample}_length_filtered_classified.sai"),
        sam=temp("results/temp/{sample}_length_filtered_classified.sam")
    threads: config["threads"]
    params:
        ref_genome=config["ref_genome"]
    benchmark:
        "results/benchmarks/map_sort_index/{sample}.txt"
    shell:
        """
        bwa aln {params.ref_genome} -t {threads} -n 0.01 -o 2 -l 16500 {input} > {output.sai}
        bwa samse {params.ref_genome} {output.sai} {input} > {output.sam}
        samtools view -@ {threads} -h -b {output.sam} | samtools sort -@ {threads} -T results/temp/{wildcards.sample} -o {output.bam}
        samtools index {output.bam}
        """

if not config["use_snp_panel"]:
    # Filter reads that overlap with SNP panel using bedtools
    rule on_target_read_filter:
        input:
            "results/mapping/{sample}_length_filtered_classified.bam"
        output:
            "results/mapping/{sample}_on_target.bam"
        shell:
            "cp {input} {output}"
else: 
    # Filter reads that overlap with SNP panel using bedtools
    rule on_target_read_filter:
        input:
            bam="results/mapping/{sample}_length_filtered_classified.bam",
            bed=config["snp_panel_bed"]
        output:
            bam="results/mapping/{sample}_on_target.bam"
        benchmark:
            "results/benchmarks/on_target_read_filter/{sample}.txt"
        shell:
            "bedtools intersect -abam {input.bam} -b {input.bed} -u > {output.bam}"

# Filter mapped reads with minimum mapping quality 
rule mapping_quality_filter:
    input:
        "results/mapping/{sample}_on_target.bam"
    output:
        "results/mapping/{sample}_LandMQ_filtered.bam"
    params: 
        quality=config["min_quality"]
    benchmark:
        "results/benchmarks/mapping_quality_filter/{sample}.txt"
    shell:
        """
        samtools view -h -q {params.quality} {input} | samtools view -bS - > {output}
        """

# Mark duplicates
rule mark_duplicates:
    input:
        "results/mapping/{sample}_LandMQ_filtered.bam"
    output:
        dedup="results/final_reads/{sample}_final.bam", 
        dedup_bai="results/final_reads/{sample}_final.bam.bai"
    benchmark:
        "results/benchmarks/mark_duplicates/{sample}.txt"
    shell:
        """
        samtools markdup -r {input} {output.dedup}
        samtools index {output.dedup} 
        """

# Run mapDamage after classification and mapping
rule run_mapdamage:
    # Samples with zero mapped reads after upstream classification/mapping/QC
    # (e.g. PCR/library blanks and other negative controls, which should have
    # ~no real hominin DNA) break mapDamage in two distinct ways, both
    # confirmed hands-on against a real mapDamage2 install:
    #   1. On some inputs/environments mapDamage exits non-zero outright.
    #   2. Even when it DOES exit 0 on a genuinely empty BAM ("Successful
    #      run"), it silently skips writing Length_plot.pdf ("No length
    #      distributions are available"), which this rule declares as a
    #      required output — Snakemake would then fail the job anyway with a
    #      missing-output error, just a different one than case 1.
    # Rather than depend on mapDamage's exact behaviour across versions/
    # platforms, short-circuit entirely when there are zero mapped reads and
    # write minimal placeholder outputs instead — there is no damage signal
    # to compute from zero reads regardless. misincorporation.txt's header
    # matches mapDamage2's real column set (confirmed against a real run) so
    # filter_deaminated_reads.py's csv.DictReader parses it identically to a
    # real (all-zero) result.
    input:
        bam_file="results/final_reads/{sample}_final.bam",
        ref_file=config["ref_genome"]
    output:
        dir=directory("results/mapdamage/{sample}"),
        dnacomp="results/mapdamage/{sample}/dnacomp.txt",
        mis_plot="results/mapdamage/{sample}/Fragmisincorporation_plot.pdf",
        length_plot="results/mapdamage/{sample}/Length_plot.pdf",
        distribution="results/mapdamage/{sample}/lgdistribution.txt",
        mis="results/mapdamage/{sample}/misincorporation.txt",
        log="results/mapdamage/{sample}/Runtime_log.txt"
    benchmark:
        "results/benchmarks/run_mapdamage/{sample}.txt"
    shell:
        """
        n_mapped=$(samtools view -c -F 4 {input.bam_file})
        if [ "$n_mapped" -eq 0 ]; then
            echo "WARNING: {input.bam_file} has 0 mapped reads — skipping mapDamage, writing placeholder outputs" >&2
            mkdir -p {output.dir}
            touch {output.dnacomp} {output.mis_plot} {output.length_plot} {output.distribution}
            printf '# table produced by mapDamage version 2.2.3 (placeholder: 0 mapped reads, mapDamage skipped)\\n# Chr: reference from sam/bam header, End: from which termini of DNA sequences, Std: strand of reads\\nChr\\tEnd\\tStd\\tPos\\tA\\tC\\tG\\tT\\tTotal\\tG>A\\tC>T\\tA>G\\tT>C\\tA>C\\tA>T\\tC>G\\tC>A\\tT>G\\tT>A\\tG>C\\tG>T\\tA>-\\tT>-\\tC>-\\tG>-\\t->A\\t->T\\t->C\\t->G\\tS\\n' > {output.mis}
            echo "0 mapped reads in {input.bam_file}: mapDamage skipped" > {output.log}
        else
            mapDamage -i {input.bam_file} -r {input.ref_file} -d {output.dir} --no-stats
        fi
        """

rule filter_deaminated_reads:
    input:
        bam_file="results/final_reads/{sample}_final.bam",
        ref_file=config["ref_genome"],
        mapdamage_misincorporation="results/mapdamage/{sample}/misincorporation.txt",
        script=workflow.source_path("../scripts/filter_deaminated_reads.py")
    output:
        deaminated_bam="results/final_reads/{sample}_final_deaminated.bam",
        non_deaminated_bam="results/final_reads/{sample}_final_non_deaminated.bam",
        deaminated_bai="results/final_reads/{sample}_final_deaminated.bam.bai",
        non_deaminated_bai="results/final_reads/{sample}_final_non_deaminated.bam.bai",
        report_file=temp("results/temp/{sample}_ct_report.csv")
    params:
        use_mapdamage=config["calculate_from_mapdamage"]
    benchmark:
        "results/benchmarks/filter_deaminated_reads/{sample}.txt"
    shell:
        """
        python {input.script} {input.bam_file} {output.deaminated_bam} {output.non_deaminated_bam} {input.ref_file} {output.report_file} --use_mapdamage={params.use_mapdamage} --mapdamage_file={input.mapdamage_misincorporation}
        samtools index {output.deaminated_bam}
        samtools index {output.non_deaminated_bam}
        """

if config.get("keep_non_hominin_reads", False):
    rule save_non_hominin_reads:
        input:
            classified_bam="results/final_reads/{sample}_final.bam",
            all_reads="results/temp/{sample}_length_filtered.fq"
        output:
            non_hominin_reads="results/final_reads/{sample}_non_hominin.fq",
            hominin_ids=temp("results/temp/{sample}_hominin_ids.lst"),
            non_hominin_read_list=temp("results/temp/{sample}_non_homin.read.lst")
        benchmark:
            "results/benchmarks/save_non_hominin_reads/{sample}.txt"
        shell:
            """
            # Extract read IDs from the classified (hominin) BAM file
            samtools view {input.classified_bam} | cut -f1 > {output.hominin_ids}

            # Extract all read headers, removing the leading '>' character, then filter out hominin reads
            seqtk seq -A {input.all_reads} | grep '^>' | sed 's/^>//' | grep -v -f {output.hominin_ids} > {output.non_hominin_read_list}

            # Extract non-hominin reads efficiently using seqtk subseq
            seqtk subseq {input.all_reads} {output.non_hominin_read_list} > {output.non_hominin_reads}
            """

# Final report generation
rule final_report:
    input:
        pre_map=f"{data_dir}/{{sample}}.fq",
        post_length="results/temp/{sample}_length_filtered.fq",
        post_classi="results/temp/{sample}_length_filtered_classified.fq",
        post_map="results/mapping/{sample}_length_filtered_classified.bam",
        post_map_on_target="results/mapping/{sample}_on_target.bam",
        post_map_qc="results/mapping/{sample}_LandMQ_filtered.bam",
        post_map_qc_rmdup="results/final_reads/{sample}_final.bam",
        deaminated_bam="results/final_reads/{sample}_final_deaminated.bam",
        report_file="results/temp/{sample}_ct_report.csv",
        check_alternate_allele=workflow.source_path("../scripts/check_alternative_allele.py")
    output:
        "results/final_report/{sample}.tsv"
    params:
        lineage_sites=config["lineage_sites"],
        types=types_str,  # Pass the preprocessed space-separated string here
        use_snp_panel=config["use_snp_panel"],
        snp_panel_bed=config.get("snp_panel_bed", "")
    shell:
        """
        id={wildcards.sample}
        types=({params.types})
        
        # Total reads 
        total_reads=$(echo $(( $(wc -l < {input.pre_map}) / 4 )))

        # Filtered reads after length check 
        length_filtered_reads=$(echo $(( $(wc -l < {input.post_length}) / 4 )))
        
        # Classified reads
        total_reads_classified=$(echo $(( $(wc -l < {input.post_classi}) / 4 )))
        
        # Mapped reads after bwa 
        mapped_reads=$(samtools view -c -F 4 {input.post_map})

        # On-target reads with SNP panel 
        on_target_reads=$(samtools view -c -F 4 {input.post_map_on_target})

        # Filtered reads after quality check 
        total_reads_post_map_qc=$(samtools view -c {input.post_map_qc})
        
        # Unique reads
        unique_reads=$(samtools view -c -F 4 {input.post_map_qc_rmdup})

        # Average duplication rate (unique_reads is 0 for samples with no reads
        # surviving upstream filtering, e.g. negative controls — bc exits
        # non-zero on divide-by-zero, which would fail this whole rule under
        # Snakemake's default set -e shell behaviour, confirmed hands-on)
        if [ "$unique_reads" -gt 0 ]; then
            dup_rate=$(echo "scale=2; $total_reads_post_map_qc / $unique_reads" | bc)
        else
            dup_rate="NA"
        fi

        # Number of SNPs covered 
        if [ "{params.use_snp_panel}" = "True" ]; then
            snps_recovered=$(bedtools intersect -a {params.snp_panel_bed} -b {input.post_map_qc_rmdup} -u | wc -l)
        else
            snps_recovered="NA"
        fi
        
        # Deaminated reads
        total_reads_deaminated=$(samtools view -c {input.deaminated_bam})

        # Percent deaminated (among classified Homo sapiens) — same
        # divide-by-zero guard as dup_rate above.
        if [ "$unique_reads" -gt 0 ]; then
            percent_deaminated=$(echo "scale=3; ($total_reads_deaminated / $unique_reads) * 100" | bc)
        else
            percent_deaminated="NA"
        fi
        
        # Initialize variables to store results for each type
        proportions=""
        proportions_deaminated=""
        proportions_headers=""

        for type in $types; do
            # Proportion hominin derived for the current type
            proportion=$(python {input.check_alternate_allele} -b {input.post_map_qc_rmdup} -v {params.lineage_sites} -t $type)
            proportions="$proportions\t$proportion"
            proportions_headers="$proportions_headers\tPercent ${{type}} derived [%]"
        done

        for type in $types; do
            # Proportion hominin derived (deaminated fragments) for the current type
            p_deaminated=$(python {input.check_alternate_allele} -b {input.deaminated_bam} -v {params.lineage_sites} -t $type)
            proportions_deaminated="$proportions_deaminated\t$p_deaminated"
            proportions_headers="$proportions_headers\tPercent ${{type}} derived deaminated [%]"
        done

        # Format C to T percentages at 5' and 3' ends as percentages with two decimal points
        ct_5=$(awk -F',' 'NR==2 {{print $1}}' {input.report_file})
        ct_3=$(awk -F',' 'NR==2 {{print $2}}' {input.report_file})
        
        # Output the final report
        echo -e "Sample ID\tSequenced reads\tLength filtered\tAfter classification\tMapped sequences\tOn-target sequences\tQuality filtered\tUnique filtered\tAverage duplication rate\tNumber of SNPs covered\tPercent deaminated [%]$proportions_headers\t5' C-to-T substitution frequency [%] (95% CI)\t3' C-to-T substitution frequency [%] (95% CI)" > {output}
        echo -e "$id\t$total_reads\t$length_filtered_reads\t$total_reads_classified\t$mapped_reads\t$on_target_reads\t$total_reads_post_map_qc\t$unique_reads\t$dup_rate\t$snps_recovered\t$percent_deaminated$proportions$proportions_deaminated\t$ct_5\t$ct_3" >> {output}
        """

# Combine all TSV files into one and delete the individual files
rule combine_reports:
    input:
        expand("results/final_report/{sample}.tsv", sample=[os.path.basename(f).split('.fq')[0] for f in input_files])
    output:
        "results/final_report/combined_final_report.tsv"
    shell:
        """
        (head -n 1 {input[0]} && tail -n +2 -q results/final_report/*.tsv) > {output}
        """

# Remove all intermediate files if requested
if config.get('to_clean', False):
    rule clean_up:
        input:
            # Add final outputs to ensure Snakemake doesn't clean prematurely
            "results/final_report/combined_final_report.tsv"
        shell:
            """
            echo "Cleaning up intermediate files..."
            rm -f results/classification/* results/mapping/*
            """